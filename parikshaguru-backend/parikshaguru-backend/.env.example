# Environment variables for ParikshaGuru Backend
# Copy this file to .env and fill in your values

# --- Database Configuration ---
# For Aiven MySQL
DB_URL=jdbc:mysql://[YOUR_AIVEN_HOST]:[PORT]/[DATABASE_NAME]
DB_USER=[YOUR_AIVEN_USER]
DB_PASSWORD=[YOUR_AIVEN_PASSWORD]

# For local MySQL
# DB_URL=jdbc:mysql://localhost:3306/parikshaguru_db?createDatabaseIfNotExist=true&useSSL=false
# DB_USER=root
# DB_PASSWORD=yourpassword

# --- Server Configuration ---
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/
SPRING_PROFILES_ACTIVE=aiven  # local, aiven, h2

# --- Security ---
JWT_SECRET=your-jwt-secret-key-here-minimum-32-characters-long
JWT_EXPIRATION_MINUTES=480

# --- Seeding & Development ---
SEED_ENABLED=false
SEED_DEMO_DATA=false

# --- CORS Configuration ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Logging ---
LOG_LEVEL=INFO